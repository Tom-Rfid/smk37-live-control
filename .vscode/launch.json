{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Déboguer les tests simulateur (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/host-tests/map_test.exe",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Program Files/CodeBlocks/MinGW/bin/gdb.exe",
      "preLaunchTask": "Compiler les tests (debug)",
      "externalConsole": false,
      "stopAtEntry": false,
      "setupCommands": [{ "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }]
    }
  ]
}
